---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';

const all = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const categories = [...new Set(all.map((p) => p.data.category))];
---

<Base title="Projetos" description="Projetos de código aberto e iniciativas técnicas de Raphael Cardoso: servidores MCP, engenharia com IA e mais.">
  <div class="wrap page">
    <p class="eyebrow">projetos</p>
    <h1>Projetos</h1>
    {categories.map((c) => (
      <section aria-labelledby={`cat-${c}`}>
        <h2 id={`cat-${c}`}>{c}</h2>
        <ul class="grid">
          {all.filter((p) => p.data.category === c).map((p) => <li><ProjectCard project={p} /></li>)}
        </ul>
      </section>
    ))}
  </div>
</Base>

<style>
  .page {
    padding-block: var(--space-12) var(--space-20);
  }
  h1 {
    font-size: clamp(2rem, 4vw, 2.8rem);
    margin-bottom: var(--space-8);
  }
  section + section {
    margin-top: var(--space-12);
  }
  h2 {
    font-size: 1.2rem;
    margin-bottom: var(--space-4);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(19rem, 1fr));
    gap: var(--space-4);
  }
  .grid > li {
    display: flex;
  }
  .grid > li > :global(*) {
    flex: 1;
  }
</style>
