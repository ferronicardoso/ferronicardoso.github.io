---
import Base from '../layouts/Base.astro';
---

<Base title="Página não encontrada">
  <div class="wrap nf">
    <p class="eyebrow">404</p>
    <h1>Página não encontrada</h1>
    <p><a href="/">Voltar para o início</a></p>
  </div>
</Base>

<style>
  .nf {
    padding-block: var(--space-20);
    display: grid;
    gap: var(--space-4);
  }
</style>
