---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';

interface Props {
  post: CollectionEntry<'writing'>;
}
const { post } = Astro.props;
const { title, summary, date, url, source, tags } = post.data;
const href = url ?? `/escrita/${post.id}/`;
const external = Boolean(url);
const when = date.toLocaleDateString('pt-BR', { month: 'short', year: 'numeric', timeZone: 'UTC' });
---

<li class="item">
  <time class="mono" datetime={date.toISOString().slice(0, 10)}>{when}</time>
  <div>
    <h3>
      <a href={href} rel={external ? 'noopener' : undefined}>
        {title}
        {external && <Icon name="external" size={15} />}
      </a>
    </h3>
    <p>{summary}</p>
    <p class="mono foot">
      {source && <span>{source}</span>}
      {tags.map((t) => <span>#{t}</span>)}
    </p>
  </div>
</li>

<style>
  .item {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: var(--space-6);
    padding-block: var(--space-6);
    border-top: 1px solid var(--line);
  }
  .item:last-child {
    border-bottom: 1px solid var(--line);
  }
  time {
    color: var(--text-muted);
    padding-top: 0.3rem;
    text-transform: capitalize;
  }
  h3 {
    font-size: 1.15rem;
  }
  h3 a {
    color: var(--text);
    text-decoration: none;
    display: inline-flex;
    gap: var(--space-2);
    align-items: baseline;
  }
  h3 a:hover {
    color: var(--accent);
    text-decoration: underline;
  }
  p {
    color: var(--text-muted);
    margin-top: var(--space-2);
    font-size: 0.97rem;
  }
  .foot {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
  }
  @media (max-width: 600px) {
    .item {
      grid-template-columns: 1fr;
      gap: var(--space-1);
    }
  }
</style>
